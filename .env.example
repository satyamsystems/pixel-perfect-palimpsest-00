# Trajectify.AI Environment Variables

# Supabase Authentication & Database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API Key (optional for live AI Assistant responses)
# Get a key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# OpenAI Compatible Key (alternative fallback)
VITE_OPENAI_API_KEY=

# App Configuration
VITE_APP_NAME="Trajectify.AI"
VITE_APP_URL="http://localhost:3000"
